+/* Local CJK extension. Terminal columns remain half-width units. */
+int buf_char_width(UChar c) {
+  if (!c) return 0;
+  int width = u_getIntPropertyValue(c, UCHAR_EAST_ASIAN_WIDTH);
+  return width == U_EA_WIDE || width == U_EA_FULLWIDTH ? 2 : 1;
+}
+
+void buf_erase_cells(struct screenchar *line, int start, int count) {
+  if (start < 0) { count += start; start = 0; }
+  if (start >= cols || count <= 0) return;
+  int end = start + count;
+  if (end > cols) end = cols;
+  if (start > 0 && line[start].c == 0 && buf_char_width(line[start-1].c) == 2) --start;
+  if (end < cols && buf_char_width(line[end-1].c) == 2 && line[end].c == 0) ++end;
+  buf_erase_line(line + start, (size_t)(end-start));
+}
+
+void buf_repair_wide(struct screenchar *line, int count) {
+  int i;
+  for (i=0; i<count; ++i) {
+    if (buf_char_width(line[i].c) == 2) {
+      if (i+1 < count && line[i+1].c == 0) ++i;
+      else buf_erase_line(line+i, 1);
+    } else if (line[i].c == 0) buf_erase_line(line+i, 1);
+  }
+}
